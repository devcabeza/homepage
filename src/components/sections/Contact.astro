---
import ScrollReveal from "../ui/ScrollReveal.astro";
---
<section id="contact" class="py-24 px-6">
  <ScrollReveal>
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-primary font-medium text-sm tracking-widest uppercase mb-3">Contacto</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-text mb-6">Hablemos <span class="text-primary">🚀</span></h2>
      <p class="text-text-muted text-lg max-w-xl mx-auto mb-10">¿Tienes un proyecto en mente o quieres conversar sobre oportunidades? Estoy abierto a nuevos retos.</p>

      <form id="contact-form" class="max-w-xl mx-auto text-left space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-text mb-1.5">Nombre</label>
            <input type="text" id="name" name="name" required
              class="w-full px-4 py-3 bg-surface border border-border rounded-xl text-text placeholder-text-muted/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-text mb-1.5">Email</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-3 bg-surface border border-border rounded-xl text-text placeholder-text-muted/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
          </div>
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-text mb-1.5">Mensaje</label>
          <textarea id="message" name="message" rows="5" required
            class="w-full px-4 py-3 bg-surface border border-border rounded-xl text-text placeholder-text-muted/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"></textarea>
        </div>
        <button type="submit" id="submit-btn"
          class="w-full sm:w-auto px-8 py-4 bg-primary text-white font-medium rounded-xl hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
          Enviar mensaje
        </button>
        <div id="form-status" class="hidden text-sm"></div>
      </form>

      <div id="contact-email" class="mt-8">
        <a href="mailto:alejandrocabezaoficial@gmail.com" class="inline-flex items-center gap-3 px-6 py-4 bg-primary text-white rounded-xl hover:bg-primary-dark transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          alejandrocabezaoficial@gmail.com
        </a>
      </div>
    </div>
  </ScrollReveal>
</section>

<script>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const statusDiv = document.getElementById('form-status');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    statusDiv.classList.add('hidden');

    const formData = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      message: document.getElementById('message').value,
    };

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData),
      });

      const data = await response.json();

      if (response.ok) {
        statusDiv.className = 'mt-4 text-sm text-green-400';
        statusDiv.textContent = '✅ Mensaje enviado correctamente. ¡Gracias!';
        form.reset();
      } else {
        statusDiv.className = 'mt-4 text-sm text-red-400';
        statusDiv.textContent = data.error || 'Error al enviar el mensaje. Intenta de nuevo.';
      }
    } catch {
      statusDiv.className = 'mt-4 text-sm text-red-400';
      statusDiv.textContent = 'Error de conexión. Intenta de nuevo.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar mensaje';
      statusDiv.classList.remove('hidden');
    }
  });
</script>
