---
import ScrollReveal from "../ui/ScrollReveal.astro";
---
<section id="education" class="py-24 px-6 bg-surface-alt">
  <ScrollReveal>
    <div class="max-w-3xl mx-auto">
      <p class="text-primary font-medium text-sm tracking-widest uppercase mb-3">Formación</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-text mb-12">Educación <span class="text-primary">Académica</span></h2>
      <div class="space-y-6">
        <div class="p-6 rounded-xl border border-border bg-surface">
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-lg font-semibold text-text">Ingeniería Informática (ITEN)</h3>
            <span class="text-xs text-text-muted bg-surface-alt px-2 py-1 rounded">Graduado 2026</span>
          </div>
          <p class="text-text-muted">IUPTAI</p>
        </div>
        <div class="p-6 rounded-xl border border-border bg-surface">
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-lg font-semibold text-text">TSU en Informática</h3>
            <span class="text-xs text-text-muted bg-surface-alt px-2 py-1 rounded">Graduado 2024</span>
          </div>
          <p class="text-text-muted">IUPTAI</p>
        </div>
      </div>
    </div>
  </ScrollReveal>
</section>
