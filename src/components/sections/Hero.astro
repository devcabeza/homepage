---
import ScrollReveal from "../ui/ScrollReveal.astro";
---
<section class="min-h-screen flex items-center justify-center px-6 pt-16">
  <ScrollReveal>
    <div class="text-center max-w-3xl">
      <p class="text-primary font-medium text-sm tracking-widest uppercase mb-4">Senior Software Engineer</p>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-text leading-tight">
        Alejandro <span class="text-primary">Cabeza</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-text-muted leading-relaxed max-w-2xl mx-auto">
        Especialista en el ecosistema Laravel y el Stack TALL. Construyo arquitecturas backend escalables y productos digitales con impacto real.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#experience" class="px-8 py-3 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors">Ver experiencia</a>
        <a href="#contact" class="px-8 py-3 border border-border text-text rounded-lg font-medium hover:border-primary hover:text-primary transition-colors">Contactar</a>
      </div>
      <div class="mt-20 animate-bounce">
        <svg class="w-6 h-6 mx-auto text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </ScrollReveal>
</section>
