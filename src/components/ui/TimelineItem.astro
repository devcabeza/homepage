---
export interface Props {
  period: string;
  role: string;
  company: string;
  highlights: string[];
  isLast?: boolean;
}
const { period, role, company, highlights, isLast = false } = Astro.props;
---
<div class="relative pl-10 pb-12">
  <div class="absolute left-[11px] top-2 bottom-0 w-0.5 bg-border" class:list={{"hidden": isLast}}></div>
  <div class="absolute left-0 top-2 w-6 h-6 rounded-full border-2 border-primary bg-surface flex items-center justify-center">
    <div class="w-2 h-2 rounded-full bg-primary"></div>
  </div>
  <div class="pt-0">
    <span class="inline-block text-xs font-medium text-primary bg-primary-light px-3 py-1 rounded-full mb-2">{period}</span>
    <h3 class="text-xl font-semibold text-text">{role}</h3>
    <p class="text-primary font-medium mb-3">{company}</p>
    <ul class="space-y-2">
      {highlights.map((item) => (
        <li class="flex items-start gap-2 text-text-muted">
          <span class="text-primary mt-1.5 shrink-0">—</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
