---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title,
  description = "Alejandro Cabeza · Senior Software Engineer",
  ogImage,
  canonicalURL = "https://alejandrocabeza.dev",
} = Astro.props;

const defaultOgImage = "/og-image.svg";
const finalOgImage = ogImage || defaultOgImage;
const fullTitle = title;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alejandro Cabeza" />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />

    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data: Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alejandro Cabeza",
      "givenName": "Alejandro",
      "familyName": "Cabeza",
      "jobTitle": "Senior Software Engineer",
      "email": "alejandrocabezaoficial@gmail.com",
      "url": "https://alejandrocabeza.dev",
      "knowsAbout": [
        "Laravel", "Livewire", "Tailwind CSS", "Alpine.js", "PHP",
        "TypeScript", "Docker", "PostgreSQL", "Redis", "Domain-Driven Design",
        "Event-Driven Architecture", "SOLID Principles"
      ],
      "worksFor": [
        {
          "@type": "Organization",
          "name": "Aludespagroup",
          "jobTitle": "Senior Full-Stack Engineer & DevOps"
        },
        {
          "@type": "Organization",
          "name": "WallsTeam",
          "jobTitle": "Senior Full-Stack Engineer"
        },
        {
          "@type": "Organization",
          "name": "Prefexya",
          "jobTitle": "Senior Backend Developer"
        },
        {
          "@type": "Organization",
          "name": "SEO Contenidos",
          "jobTitle": "Full Stack Developer"
        }
      ],
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "IUPTAI"
        }
      ],
      "knowsLanguage": [
        { "@type": "Language", "name": "Spanish", "alternateName": "es" },
        { "@type": "Language", "name": "English", "alternateName": "en" }
      ]
    })}/>

    <!-- JSON-LD Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Alejandro Cabeza",
      "url": "https://alejandrocabeza.dev",
      "description": "Portfolio de Alejandro Cabeza · Senior Software Engineer especializado en Stack TALL y ecosistema Laravel.",
      "inLanguage": "es-ES",
      "author": {
        "@type": "Person",
        "name": "Alejandro Cabeza"
      }
    })}/>
  </head>
  <body class="bg-surface text-text font-['Inter'] antialiased">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-md border-b border-border">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="#" class="text-lg font-semibold text-text">AC<span class="text-primary">.</span></a>
        <div class="hidden sm:flex items-center gap-8 text-sm font-medium text-text-muted">
          <a href="#about" class="hover:text-primary transition-colors">Sobre mí</a>
          <a href="#experience" class="hover:text-primary transition-colors">Experiencia</a>
          <a href="#skills" class="hover:text-primary transition-colors">Skills</a>
          <a href="#projects" class="hover:text-primary transition-colors">Proyectos</a>
          <a href="#contact" class="hover:text-primary transition-colors">Contacto</a>
        </div>
        <button class="sm:hidden" aria-label="Menú">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="border-t border-border py-8 text-center text-sm text-text-muted">
      <div class="max-w-5xl mx-auto px-6">
        <p>© {new Date().getFullYear()} Alejandro Cabeza. Todos los derechos reservados.</p>
        <p class="mt-1">Hecho con <a href="https://astro.build" class="text-primary hover:underline" target="_blank" rel="noopener">Astro</a> y <a href="https://tailwindcss.com" class="text-primary hover:underline" target="_blank" rel="noopener">Tailwind CSS</a></p>
      </div>
    </footer>
  </body>
</html>
